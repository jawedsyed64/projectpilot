<Window x:Class="ProjectPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectPilot.ViewModels"
        xmlns:v="clr-namespace:ProjectPilot.Views"
        Title="ProjectPilot — AI Project Manager"
        Width="1340" Height="840" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><v:ProjectsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}"><v:TasksView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}"><v:TimelineView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MilestonesViewModel}"><v:MilestonesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}"><v:ComingSoonView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,20">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="White" FontSize="17"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProjectPilot" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="AI Project Manager" Foreground="{DynamicResource SidebarFg}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Foreground="{DynamicResource SidebarFg}"
                           Opacity="0.6" FontSize="11" Margin="22,10,20,16"/>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource NavItemStyle}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" CornerRadius="6" Padding="5,1" Background="#33FFFFFF"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsComingSoon, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Phase, StringFormat='P{0}'}" FontSize="10" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Automatic deadline alert -->
            <Border Margin="28,14,28,0" CornerRadius="8" Padding="14,8"
                    Background="{Binding BannerKey, Converter={StaticResource BrushKey}}"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding DismissBannerCommand}"
                            ToolTip="Dismiss" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Foreground="White"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding OpenDashboardCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="View dashboard" Foreground="White" FontWeight="SemiBold" TextDecorations="Underline"/>
                    </Button>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BannerText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="28,18,28,20" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
