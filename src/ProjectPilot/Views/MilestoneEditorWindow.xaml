<Window x:Class="ProjectPilot.Views.MilestoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="760" Height="640" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project *" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanChangeProject}"/>
                <TextBlock Text="Milestone name *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="15"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Date *" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding DueDate}"/>
                <Button Content="Use the latest date of the ticked tasks" Command="{Binding UseLatestTaskDateCommand}"
                        Style="{StaticResource LinkButton}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                <CheckBox Content="Milestone completed" IsChecked="{Binding IsCompleted}" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}" MinHeight="50"/>
            <TextBlock Text="Tasks that must be finished for this milestone" Style="{StaticResource FieldLabel}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <TextBlock Text="This project has no tasks yet." Style="{StaticResource Muted}" Margin="4"
                           Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}"/>
                <ListBox ItemsSource="{Binding Tasks}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Due, StringFormat='{}{0:dd MMM}'}" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="8,0,0,0"
                                        Background="{Binding Status, Converter={StaticResource BrushKey}}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplay}}" Style="{StaticResource PillText}"/>
                                </Border>
                                <CheckBox IsChecked="{Binding IsChecked}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                <Button Content="Save milestone" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="130"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
