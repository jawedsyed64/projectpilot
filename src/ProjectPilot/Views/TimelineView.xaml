<UserControl x:Class="ProjectPilot.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ProjectPilot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding AddTaskCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                        <TextBlock Text="Task"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddMilestoneCommand}" Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                        <TextBlock Text="Milestone"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Timeline &amp; Gantt" Style="{StaticResource H1}"/>
                <TextBlock Text="Plan and track the schedule. Drag bars to reschedule — dependent tasks follow automatically after you confirm."
                           Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Project" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="250" ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}" Margin="0,0,16,6"/>
            <TextBlock Text="Zoom" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="100" ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding Zoom}" Margin="0,0,16,6"/>
            <CheckBox Content="Highlight critical path" IsChecked="{Binding ShowCritical}" Margin="0,0,16,6" VerticalAlignment="Center"/>
            <CheckBox Content="Show planned dates (baseline)" IsChecked="{Binding ShowBaseline}" Margin="0,0,16,6" VerticalAlignment="Center"/>
            <Button Content="Go to today" Click="TodayButton_Click" Margin="0,0,8,6" Padding="10,5"/>
            <Button Content="Set baseline…" Command="{Binding SetBaselineCommand}" Margin="0,0,8,6" Padding="10,5"
                    ToolTip="Save the current dates as the plan, to compare planned vs actual later"/>
            <Button Command="{Binding ReloadCommand}" Margin="0,0,8,6" Padding="10,5" ToolTip="Refresh">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
            </Button>
        </WrapPanel>

        <!-- Tracking summary -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12"
                Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Project health" Style="{StaticResource Muted}" FontSize="11"/>
                    <Border Style="{StaticResource Pill}" Margin="0,4,0,4" Padding="10,3"
                            Background="{Binding HealthLevel, Converter={StaticResource BrushKey}}">
                        <TextBlock Text="{Binding HealthLevel, Converter={StaticResource EnumDisplay}}" Style="{StaticResource PillText}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding HealthReason}" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Completion" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="22" FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,2,0,2"/>
                    <TextBlock Text="{Binding ExpectedText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Planned end (target)" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding PlannedEndText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="Forecast end" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding ForecastEndText}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Planned vs forecast" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding VarianceText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{Binding VarianceKey, Converter={StaticResource BrushKey}}"/>
                    <TextBlock Text="Milestones" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding MilestoneText}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,12,0">
                    <TextBlock Text="Overdue tasks" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding OverdueCount}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Awaiting review / approval" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding ReviewCount}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Text="Critical tasks" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding CriticalCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
                    <TextBlock Text="any delay to these delays the whole project" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chart + attention list -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctl:GanttChart x:Name="Chart" Margin="1"
                                    Data="{Binding Chart}"
                                    PixelsPerDay="{Binding PixelsPerDay}"
                                    ShowCritical="{Binding ShowCritical}"
                                    ShowBaseline="{Binding ShowBaseline}"
                                    HorizontalOffset="{Binding Value, ElementName=HScroll}"
                                    VerticalOffset="{Binding Value, ElementName=VScroll}"/>
                    <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical" Minimum="0" SmallChange="32"/>
                    <ScrollBar x:Name="HScroll" Grid.Row="1" Orientation="Horizontal" Minimum="0" SmallChange="40"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Width="270" Margin="10,0,0,0"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Needs attention" Style="{StaticResource H2}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Overdue, slipping or waiting for review. Click to open."
                               Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="Nothing needs attention. 👍" Style="{StaticResource Muted}"
                               Visibility="{Binding Attention.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Attention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" HorizontalContentAlignment="Stretch" Margin="0,3"
                                            Command="{Binding DataContext.OpenAttentionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Style="{StaticResource Pill}" Background="{Binding DisplayStatus, Converter={StaticResource BrushKey}}">
                                                    <TextBlock Text="{Binding DisplayStatus, Converter={StaticResource EnumDisplay}}" Style="{StaticResource PillText}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DueDate, StringFormat='{}  due {0:dd MMM}'}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Legend -->
        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <WrapPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,14,0"/>
                </Style>
            </WrapPanel.Resources>
            <Rectangle Width="18" Height="9" RadiusX="3" RadiusY="3" Fill="{DynamicResource Info}" Margin="0,0,5,0"/>
            <TextBlock Text="Task (darker part = progress)"/>
            <Rectangle Width="18" Height="9" RadiusX="3" RadiusY="3" Stroke="{DynamicResource Danger}" StrokeThickness="2" Margin="0,0,5,0"/>
            <TextBlock Text="Critical path"/>
            <Rectangle Width="18" Height="4" Fill="{DynamicResource TextSecondary}" Opacity="0.6" Margin="0,0,5,0"/>
            <TextBlock Text="Planned (baseline)"/>
            <TextBlock Text="◆" Foreground="{DynamicResource Purple}" Margin="0,0,5,0"/>
            <TextBlock Text="Milestone"/>
            <Rectangle Width="2" Height="14" Fill="{DynamicResource Danger}" Margin="0,0,5,0"/>
            <TextBlock Text="Today"/>
            <Rectangle Width="2" Height="14" Fill="{DynamicResource Accent}" Margin="0,0,5,0"/>
            <TextBlock Text="Project target date"/>
            <TextBlock Text="·  Mouse wheel scrolls, Shift+wheel scrolls sideways, Ctrl+wheel zooms"/>
        </WrapPanel>
    </Grid>
</UserControl>
