<Window x:Class="ProjectPilot.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1060" Height="780" MinWidth="840" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding OverdueNote}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- ============ Left: task details ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Project *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanChangeProject}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Parent task (makes this a subtask)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding SelectedParent}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Task title *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="15"/>

                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Assigned to" Style="{StaticResource FieldLabel}"/>
                        <ComboBox IsEditable="True" ItemsSource="{Binding PeopleSuggestions}"
                                  Text="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" ItemTemplate="{StaticResource EnumItem}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" ItemTemplate="{StaticResource EnumItem}"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StartDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Deadline (due date)" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DueDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Repeats" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Recurrences}" SelectedItem="{Binding Recurrence}" ItemTemplate="{StaticResource EnumItem}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="Progress: "/><Run Text="{Binding Progress, Mode=OneWay}"/><Run Text="%"/>
                </TextBlock>
                <Slider Minimum="0" Maximum="100" Value="{Binding Progress}" TickFrequency="5" IsSnapToTickEnabled="True"
                        SmallChange="5" LargeChange="10"/>

                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}"/>

                <TextBlock Text="Depends on (this task can't really start until these are finished)" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <TextBlock Text="No other tasks in this project yet." Style="{StaticResource Muted}" Margin="4"
                                   Visibility="{Binding HasNoDependencyOptions, Converter={StaticResource BoolToVis}}"/>
                        <ListBox ItemsSource="{Binding Dependencies}" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                Background="{Binding Status, Converter={StaticResource BrushKey}}">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}"/>
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsChecked}">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        </CheckBox>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Right: subtasks, files, comments, history ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,6,10">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add subtask" Command="{Binding AddSubtaskCommand}" Padding="10,4"/>
                            <TextBlock Text="Subtasks" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="No subtasks." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding Subtasks.Count, Converter={StaticResource ZeroToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Subtasks}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                Background="{Binding DisplayStatus, Converter={StaticResource BrushKey}}">
                                            <TextBlock Text="{Binding DisplayStatus, Converter={StaticResource EnumDisplay}}" Style="{StaticResource PillText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add files…" Command="{Binding AddAttachmentCommand}" Padding="10,4"/>
                            <TextBlock Text="Attachments" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="No files attached." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding Attachments.Count, Converter={StaticResource ZeroToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Foreground="{DynamicResource Danger}"/>
                                        </Button>
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}"/>
                                        <Button Style="{StaticResource LinkButton}" ToolTip="Open"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Comments &amp; updates" Style="{StaticResource H2}"/>
                        <TextBlock Text="Save the task first to add comments." Style="{StaticResource Muted}"
                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}" MinHeight="50"/>
                            <Button Content="Add comment" Command="{Binding AddCommentCommand}" HorizontalAlignment="Right" Margin="0,6,0,6" Padding="10,4"/>
                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                    <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding IsExisting, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Activity history" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="{DynamicResource TextSecondary}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Buttons ============ -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                <Button Content="Save task" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
