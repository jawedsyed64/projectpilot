<UserControl x:Class="ProjectPilot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,8,0">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
                        <TextBlock Grid.Row="1" Text="Your name (shown on comments)" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                 Text="{Binding UserName, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Data, backup &amp; recovery" Style="{StaticResource H2}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}">
                        Everything you do is saved automatically, straight away, in a database on this PC.
                        A backup copy is also made automatically once a day (the last 10 are kept).
                    </TextBlock>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run Text="Database file: " Foreground="{DynamicResource TextSecondary}"/><Run Text="{Binding DatabaseFile, Mode=OneWay}"/>
                    </TextBlock>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Back up now…" Command="{Binding BackupNowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
                        <Button Content="Restore from backup…" Command="{Binding RestoreCommand}" Margin="0,0,8,6"/>
                        <Button Content="Open automatic backups folder" Command="{Binding OpenBackupsFolderCommand}" Margin="0,0,8,6"/>
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="What works offline and what needs the internet" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Feature}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WorksWhere}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AI assistant" Style="{StaticResource H2}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}">
                        The AI Project Assistant is added in Phase 3. You will be able to choose Claude (Anthropic), OpenAI or
                        Google Gemini and enter your own API key here. The key will be stored encrypted on this PC and only sent
                        to the AI provider you choose.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
