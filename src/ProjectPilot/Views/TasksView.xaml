<UserControl x:Class="ProjectPilot.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NewTaskCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                    <TextBlock Text="New Task"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Tasks" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Search" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <TextBox Width="210" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Project" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ComboBox Width="200" ItemsSource="{Binding ProjectFilters}" SelectedItem="{Binding ProjectFilter}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ComboBox Width="180" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ComboBox Width="130" ItemsSource="{Binding PriorityFilters}" SelectedItem="{Binding PriorityFilter}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Owner" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ComboBox Width="150" ItemsSource="{Binding AssigneeFilters}" SelectedItem="{Binding AssigneeFilter}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Group by" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ComboBox Width="130" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding GroupBy}"/>
            </StackPanel>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface2Bg}" Padding="10,6">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding Name, Mode=OneWay, Converter={StaticResource EnumDisplay}}"/>
                                    <Run Text="  ("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Task" SortMemberPath="Title" Width="2.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Margin="8,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource Warning}" ToolTip="Waiting on unfinished dependencies"
                                           Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="&#xE8EE;" Style="{StaticResource Icon}" Margin="8,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" ToolTip="Recurring task"
                                           Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="1.2*"/>
                <DataGridTextColumn Header="Owner" Binding="{Binding AssigneeDisplay}" Width="*"/>
                <DataGridTemplateColumn Header="Priority" SortMemberPath="Priority" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{Binding Priority, Converter={StaticResource BrushKey}}">
                                <TextBlock Text="{Binding Priority}" Style="{StaticResource PillText}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" SortMemberPath="DisplayStatus" Width="115">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{Binding DisplayStatus, Converter={StaticResource BrushKey}}">
                                <TextBlock Text="{Binding DisplayStatus, Converter={StaticResource EnumDisplay}}" Style="{StaticResource PillText}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Due" SortMemberPath="DueDate" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd MMM yyyy}'}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Progress" SortMemberPath="EffectiveProgress" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding EffectiveProgress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding EffectiveProgress, StringFormat='{}{0}%'}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}"
                   TextAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding Tasks.Count, Converter={StaticResource ZeroToVis}}"
                   Text="No tasks match these filters.&#x0a;Click “New Task” to add one."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding MarkCompleteCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0" Foreground="{DynamicResource Success}"/>
                    <TextBlock Text="Mark complete"/>
                </StackPanel>
            </Button>
            <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
            <Button Content="Add subtask" Command="{Binding AddSubtaskCommand}" Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="Click a column header to sort · double-click a task to edit"/>
        </StackPanel>
    </Grid>
</UserControl>
