<UserControl x:Class="ProjectPilot.Views.MilestonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                    <TextBlock Text="New Milestone"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Milestones" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Project" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="250" ItemsSource="{Binding ProjectFilters}" SelectedItem="{Binding ProjectFilter}" Margin="0,0,16,0"/>
            <CheckBox Content="Show completed milestones" IsChecked="{Binding ShowCompleted}" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Milestones}" SelectedItem="{Binding Selected}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Milestone" SortMemberPath="Title" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◆" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{Binding StatusKey, Converter={StaticResource BrushKey}}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="1.3*"/>
                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='{}{0:ddd dd MMM yyyy}'}" SortMemberPath="DueDate" Width="130"/>
                <DataGridTemplateColumn Header="Status" SortMemberPath="StatusText" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{Binding StatusKey, Converter={StaticResource BrushKey}}">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Linked tasks" SortMemberPath="Progress" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding LinkedText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource Muted}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Completed on" Binding="{Binding CompletedAt, StringFormat='{}{0:dd MMM yyyy}'}" SortMemberPath="CompletedAt" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}"
                   TextAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding Milestones.Count, Converter={StaticResource ZeroToVis}}"
                   Text="No milestones yet.&#x0a;Milestones mark key checkpoints — e.g. “Design approved” or “Launch”. Link tasks to them to track progress."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding ToggleCompleteCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0" Foreground="{DynamicResource Success}"/>
                    <TextBlock Text="Mark complete / reopen"/>
                </StackPanel>
            </Button>
            <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
            <TextBlock Text="Tip: milestones also appear as ◆ on the Timeline, where you can drag them to a new date."
                       Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
